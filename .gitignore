# ---- Python 运行产物 ----
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/

# ---- 虚拟环境（几百 MB，绝不能提交）----
.venv/
venv/
env/

# ---- IDE 配置 ----
.idea/
.vscode/
*.iml

# ---- 秘密：API Key 绝不能进 git ----
.env
.env.*
!.env.example

# ---- 测试/检查产物 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- 运行垃圾 ----
*.log
*.tmp
*.bak

# ---- 操作系统的垃圾文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本项目运行时生成的数据（程序自己会重建）----
data/
